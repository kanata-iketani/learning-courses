    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>TODOアプリ(土台)</title>\n</head>\n<body>\n  <div id=\"app\">\n    <h1>TODOリスト</h1>\n    <input v-model=\"newText\" placeholder=\"やることを入力\">\n    <button v-on:click=\"addTodo\">追加</button>\n    <ul>\n      <!-- :key には追加・削除しても変わらない id を使う -->\n      <li v-for=\"todo in todos\" :key=\"todo.id\">{{ todo.text }}</li>\n    </ul>\n    <p>全部で {{ todos.length }} 件</p>\n  </div>\n\n  <script src=\"/vendor/vue.global.prod.js\"></script>\n  <script>\n    const { createApp } = Vue;\n    createApp({\n      data() {\n        return {\n          newText: \"\",\n          nextId: 3,\n          todos: [\n            { id: 1, text: \"牛乳を買う\" },\n            { id: 2, text: \"部屋のそうじ\" }\n          ]\n        };\n      },\n      methods: {\n        addTodo() {\n          // 工夫した点: id は nextId で採番し、使ったら 1 増やして重複を防ぐ\n          this.todos.push({ id: this.nextId, text: this.newText });\n          this.nextId++;\n          // v-model のおかげで、data を空にすれば入力欄も空になる\n          this.newText = \"\";\n        }\n      }\n    }).mount(\"#app\");\n  </script>\n</body>\n</html>\n"
