    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>TODOアプリ(完了チェック)</title>\n<style>\n  .done { text-decoration: line-through; color: #999; }\n</style>\n</head>\n<body>\n  <div id=\"app\">\n    <h1>TODOリスト(残り {{ remaining }} 件)</h1>\n    <input v-model=\"newText\" placeholder=\"やることを入力\">\n    <button v-on:click=\"addTodo\">追加</button>\n    <ul>\n      <li v-for=\"todo in todos\" :key=\"todo.id\">\n        <input type=\"checkbox\" v-model=\"todo.done\">\n        <!-- 工夫した点: :class のオブジェクト書式なら、true/false でクラスが自動で付け外しされる -->\n        <span :class=\"{ done: todo.done }\">{{ todo.text }}</span>\n      </li>\n    </ul>\n  </div>\n\n  <script src=\"/vendor/vue.global.prod.js\"></script>\n  <script>\n    const { createApp } = Vue;\n    createApp({\n      data() {\n        return {\n          newText: \"\",\n          nextId: 3,\n          todos: [\n            { id: 1, text: \"牛乳を買う\", done: false },\n            { id: 2, text: \"部屋のそうじ\", done: false }\n          ]\n        };\n      },\n      computed: {\n        // filter で「未完了だけの配列」を作り、その長さを数える\n        remaining() {\n          return this.todos.filter(todo => !todo.done).length;\n        }\n      },\n      methods: {\n        addTodo() {\n          // 新しい TODO は必ず done: false で始める\n          this.todos.push({ id: this.nextId, text: this.newText, done: false });\n          this.nextId++;\n          this.newText = \"\";\n        }\n      }\n    }).mount(\"#app\");\n  </script>\n</body>\n</html>\n"
  }
