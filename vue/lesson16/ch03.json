    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>TODOアプリ(完成版)</title>\n<style>\n  .done { text-decoration: line-through; color: #999; }\n</style>\n</head>\n<body>\n  <div id=\"app\">\n    <h1>TODOリスト(残り {{ remaining }} 件)</h1>\n    <input v-model=\"newText\" placeholder=\"やることを入力\">\n    <button v-on:click=\"addTodo\">追加</button>\n    <ul>\n      <li v-for=\"todo in todos\" :key=\"todo.id\">\n        <input type=\"checkbox\" v-model=\"todo.done\">\n        <span :class=\"{ done: todo.done }\">{{ todo.text }}</span>\n        <!-- どの行のボタンか分かるように、todo.id を引数で渡す -->\n        <button v-on:click=\"removeTodo(todo.id)\">削除</button>\n      </li>\n    </ul>\n  </div>\n\n  <script src=\"/vendor/vue.global.prod.js\"></script>\n  <script>\n    const { createApp } = Vue;\n    createApp({\n      data() {\n        return {\n          newText: \"\",\n          nextId: 3,\n          todos: [\n            { id: 1, text: \"牛乳を買う\", done: false },\n            { id: 2, text: \"部屋のそうじ\", done: false }\n          ]\n        };\n      },\n      computed: {\n        remaining() {\n          return this.todos.filter(todo => !todo.done).length;\n        }\n      },\n      methods: {\n        addTodo() {\n          // 工夫した点: trim() で前後の空白を除いてから判定するので、\n          // スペースだけの入力もガードできる\n          if (this.newText.trim() === \"\") return;\n          this.todos.push({ id: this.nextId, text: this.newText, done: false });\n          this.nextId++;\n          this.newText = \"\";\n        },\n        removeTodo(id) {\n          // 「消す」のではなく「その id 以外を残した新しい配列」で置きかえる\n          this.todos = this.todos.filter(todo => todo.id !== id);\n        }\n      }\n    }).mount(\"#app\");\n  </script>\n</body>\n</html>\n"
  }
