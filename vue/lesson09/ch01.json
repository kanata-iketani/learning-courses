    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>プロフィールカード</title>\n</head>\n<body>\n  <h1>プロフィール</h1>\n  <!-- 工夫: HTML 側は空にして、中身はすべて JS から書き込む -->\n  <p>名前: <span id=\"name\"></span></p>\n  <p>趣味: <span id=\"hobby\"></span></p>\n\n  <script>\n    // 要素を取り出してから textContent で書きかえる、が基本の型\n    const nameEl = document.getElementById(\"name\");\n    nameEl.textContent = \"いけたに\";\n\n    // 変数に入れずにその場で書きかえてもよい\n    document.getElementById(\"hobby\").textContent = \"プログラミング\";\n  </script>\n</body>\n</html>\n"
