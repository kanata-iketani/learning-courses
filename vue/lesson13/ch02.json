    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>アンケートフォーム</title>\n</head>\n<body>\n  <div id=\"app\">\n    <!-- 工夫した点: label で囲むと文字クリックでもチェックが切り替わる -->\n    <label><input type=\"checkbox\" v-model=\"mailmaga\"> メルマガを受け取る</label>\n    <p>受け取る設定: {{ mailmaga }}</p>\n    <hr>\n    <p>好きな季節:\n      <select v-model=\"season\">\n        <option value=\"春\">春</option>\n        <option value=\"夏\">夏</option>\n        <option value=\"秋\">秋</option>\n        <option value=\"冬\">冬</option>\n      </select>\n    </p>\n    <!-- season の初期値が「春」なので、開いた瞬間から文章が成立する -->\n    <p>あなたは {{ season }} が好きなのですね。</p>\n  </div>\n\n  <script src=\"/vendor/vue.global.prod.js\"></script>\n  <script>\n    const { createApp } = Vue;\n    createApp({\n      data() {\n        return { mailmaga: false, season: \"春\" };\n      }\n    }).mount(\"#app\");\n  </script>\n</body>\n</html>\n"
