    "answer": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<title>買い物リスト</title>\n</head>\n<body>\n  <div id=\"app\">\n    <p>買い物リスト</p>\n    <ul>\n      <!-- :key には重複しない id を渡す。index より確実な目印になる -->\n      <li v-for=\"item in items\" :key=\"item.id\">\n        <label><input type=\"checkbox\" v-model=\"item.done\"> {{ item.text }}</label>\n      </li>\n    </ul>\n    <p>まだ買っていないもの:</p>\n    <ul>\n      <!-- 工夫した点: v-for は template、v-if は li と、役割ごとにタグを分けた。\n           同じタグに書くと Vue 3 では v-if が先に評価されてエラーになる -->\n      <template v-for=\"item in items\" :key=\"item.id\">\n        <li v-if=\"!item.done\">{{ item.text }}</li>\n      </template>\n    </ul>\n  </div>\n\n  <script src=\"/vendor/vue.global.prod.js\"></script>\n  <script>\n    const { createApp } = Vue;\n    createApp({\n      data() {\n        return {\n          items: [\n            { id: 1, text: \"牛乳\", done: false },\n            { id: 2, text: \"卵\", done: false },\n            { id: 3, text: \"食パン\", done: false }\n          ]\n        };\n      }\n    }).mount(\"#app\");\n  </script>\n</body>\n</html>\n"
